{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["packages/*/src/**/*.ts", "templates/*/src/**/*.ts", "templates/features/**/*.ts", "apps/*/src/**/*.ts", "apps/*/next.config.ts", "apps/*.ts", "*.ts"],
  // The tests that draw the app's own `.tsx`, which the app's config checks with
  // its JSX and its `@/` alias (`apps/asas-tanstack/tsconfig.json`), and the one
  // that draws the template's, which no config here carries JSX for.
  "exclude": [
    "apps/asas-tanstack/src/screen-form.test.ts",
    "apps/asas-tanstack/src/screen-list.test.ts",
    "apps/asas-tanstack/src/auth.test.ts",
    "apps/asas-tanstack/src/no-organization.test.ts",
    "apps/asas-tanstack/src/activity.test.ts",
    "templates/asas/src/ui-dashboard/members.test.ts",
    // The server entries check each screen against the app's components map, which they read from its \`.tsx\`
    // through Vite's \`import.meta.glob\`; each app's own config checks them with both. The map itself is drawn
    // from mithaq-admin's `.tsx`, so it is checked there too.
    "apps/*/src/server.ts",
    "apps/*/src/components.ts"
  ]
}
