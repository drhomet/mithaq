# The settings a development machine runs with; every variable is described in
# README.md, "Environment variables".
# create-mithaq writes a copy as `.env` here, in `apps/asas-tanstack` and in
# `apps/asas-platform`, with the same fresh secrets in each. The `seed` script
# and the apps' Vite read it, and `node --env-file=.env` does; the `mithaq`
# bin does not. A variable the shell already sets wins.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mithaq
# 32 characters at least. Unset, every POST under /api/auth/local answers 503.
LOCAL_AUTH_SECRET=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
PLATFORM_URL=http://localhost:5174
# The account `bun run dev:setup` makes on a fresh database on this machine:
# the owner of an organization and, with the platform console, its super_admin.
# A development value only: dev:setup refuses any other database.
DEV_ADMIN_EMAIL=admin@example.com
DEV_ADMIN_PASSWORD=dev-admin-password
# The platform console's first administrator, and with one organization or
# none the app's first owner, are made only with this code, entered on
# /auth/create-first-user or /auth/first-run. Set a random value of 32
# characters or more before the first start outside development; a shorter
# one counts as unset. `vite dev` on this machine asks for none.
SETUP_CODE=
# The mailer: both, or neither. Without them a password reset is offered only
# in development, where the link is written to the server log, and an open
# sign-up refuses to start in production.
# RESEND_API_KEY=
# MAIL_FROM=Asas <mail@example.com>
# Required in production; development defaults them, the secret to a new
# random one on every start.
# STORAGE_SECRET=
# STORAGE_PREFIX=mithaq/asas
# STORAGE_ADAPTER=local
