{
  "name": "mithaq",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "templates/*",
    "templates/features/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node apps/test.ts",
    "test:next": "RESEND_API_KEY=re_test_never_sent MAIL_FROM=tests@example.com RESEND_BASE_URL=http://127.0.0.1:9 node --test apps/next-boot.ts",
    "test:tanstack": "RESEND_API_KEY=re_test_never_sent MAIL_FROM=tests@example.com RESEND_BASE_URL=http://127.0.0.1:9 node --test apps/tanstack-boot.ts",
    "test:r2": "node --test templates/mithaq/src/storage/r2.smoke.ts",
    "test:release": "node apps/release-consumer.ts",
    "pack": "node apps/pack.ts",
    "lint:args": "node apps/lint-args.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/mithaq-admin && tsc -p apps/asas-tanstack && tsc -p apps/asas-backoffice",
    "test:unit": "node apps/test.ts --unit"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@types/node": "^24.12.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2"
  }
}
