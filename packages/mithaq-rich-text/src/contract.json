{
  "formats": {"bold": 1, "italic": 2, "strikethrough": 4, "underline": 8, "inlineCode": 16, "subscript": 32, "superscript": 64, "highlight": 128, "lowercase": 256, "uppercase": 512, "capitalize": 1024},
  "paragraphs": ["p", "bullet", "number", "h2", "h3", "quote", "divider", "upload"],
  "transport": {"jsonObjectParams": ["runs", "fields"], "note": "Upload runs and insertUpload fields may be JSON strings, decoded before validation, to preserve nulls through Lynx iOS method arguments. Results remain objects. Change events include optional uploadsJSON to preserve opaque booleans and nulls."},
  "upload": {"maxValueLength": 255, "formats": ["", "left", "start", "center", "right", "end", "justify"], "storedFields": ["relationTo", "value", "fields", "id", "format"]},
  "directions": ["auto", "ltr", "rtl"],
  "blockKinds": ["section", "problem"],
  "runsVersion": 2,
  "placements": ["inline", "paragraph"],
  "methods": {
    "setContent": {"params": {"runs": "runs", "runsVersion": "int?"}, "returns": "accepted"},
    "toggleFormat": {"params": {"format": "int"}},
    "clearFormat": {},
    "setParagraphKind": {"params": {"kind": "string"}},
    "insertText": {"params": {"text": "string"}},
    "replaceRange": {"params": {"start": "int", "end": "int", "text": "string?", "runs": "runs?"}},
    "setSelection": {"params": {"start": "int", "end": "int"}},
    "focus": {},
    "blur": {},
    "getContent": {"returns": "content"},
    "undo": {},
    "redo": {},
    "insertDivider": {},
    "insertUpload": {"params": {"relationTo": "string", "value": "string", "fields": "object?", "name": "string?", "mime": "string?", "src": "string?"}},
    "setUploadSources": {"params": {"sources": "object"}},
    "flush": {}
  },
  "laidOutDirections": ["ltr", "rtl"],
  "results": {
    "change": {"runs": "runs", "selection": "selection", "isComposing": "boolean", "uploadsJSON": "string?"},
    "content": {"runs": "runs", "selection": "selection", "isComposing": "boolean", "directions": "laidOutDirection[]"}
  },
  "events": ["change", "selection", "focus", "blur", "linktap", "formatstate"],
  "errors": ["native-owns-content", "invalid-input", "composition-active", "locked-content"],
  "attributes": {
    "block-id": {"type": "string"},
    "block-kind": {"type": "string"},
    "placeholder": {"type": "string"},
    "editable": {"type": "boolean", "default": true},
    "autocorrect": {"type": "boolean", "default": false},
    "spellcheck": {"type": "boolean", "default": false},
    "no-personalized-learning": {"type": "boolean", "default": true}
  },
  "changeDebounceMs": 300,
  "clipboardExpirySeconds": 120,
  "undoDepth": 40,
  "headings": {"h2": {"fontSize": 18, "lineHeight": 28, "fontWeight": 600}, "h3": {"fontSize": 16, "lineHeight": 24, "fontWeight": 600}}
}
