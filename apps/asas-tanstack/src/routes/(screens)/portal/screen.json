{
  "path": "/portal",
  "providers": [
    "@asas/mithaq:./src/ui/rich-text-nodes.tsx#RichTextNodes",
    "@asas/courses:./enrollments/ui/session-labels.tsx#SessionLabels"
  ],
  "pages": {
    "home": {
      "path": "/",
      "component": "./src/ui-portal/home.tsx#Home"
    }
  },
  "nav": [
    {
      "path": "/courses",
      "page": "list",
      "kayan": "courses",
      "permission": "courses.find"
