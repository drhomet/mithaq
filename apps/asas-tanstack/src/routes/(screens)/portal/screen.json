  },
  "components": {},
  "controls": {
    "text": {
      "control": "text",
      "cell": "text"
    },
    "email": {
      "control": "email",
      "cell": "email"
    },
    "number": {
      "control": "number",
      "cell": "number"
    },
    "integer": {
      "control": "integer",
      "cell": "integer"
    },
    "decimal": {
      "control": "decimal",
      "cell": "decimal"
    },
    "checkbox": {
      "control": "checkbox",
      "cell": "checkbox"
    },
    "datetime": {
      "control": "datetime",
      "cell": "datetime"
    },
    "date": {
      "control": "date",
      "cell": "date"
    },
    "textArray": {
      "control": "textArray",
      "cell": "textArray"
    },
    "uuid": {
      "control": "uuid",
      "cell": "uuid"
    },
    "relationship": {
      "control": "relationship",
      "cell": "relationship"
    },
    "join": {
      "control": "join",
      "cell": "join"
    },
    "richText": {
      "control": "richText",
      "cell": "richText"
    },
    "upload": {
      "control": "upload",
      "cell": "upload"
    }
  },
  "kayan": {
    "courses": {
      "name": "courses",
      "single": false,
      "fields": [
        {
          "name": "id",
          "kind": "uuid",
          "label": {
            "en": "ID",
            "ar": "المعرف"
          },
          "rules": {
            "required": false
          },
          "component": "uuid",
          "cell": "uuid"
        },
        {
          "name": "updatedAt",
          "kind": "datetime",
          "label": {
            "en": "Updated at",
            "ar": "تاريخ التعديل"
          },
          "rules": {
            "required": true,
            "defaultNow": true,
            "nowOnUpdate": true,
            "providedBy": {
              "create": "application",
              "update": "application"
            }
          },
          "component": "datetime",
          "cell": "datetime"
        },
        {
          "name": "createdAt",
          "kind": "datetime",
          "label": {
            "en": "Created at",
            "ar": "تاريخ الإنشاء"
          },
          "rules": {
            "required": true,
            "defaultNow": true,
            "index": true,
            "providedBy": {
              "create": "application",
              "update": "application"
            }
          },
          "component": "datetime",
          "cell": "datetime"
        },
        {
          "name": "organization",
          "kind": "relationship",
          "label": {
            "en": "Organization",
            "ar": "المؤسسة"
          },
          "rules": {
            "required": true,
            "index": true,
            "providedBy": {
              "create": "application",
              "update": "never"
            },
            "onDelete": "restrict"
          },
          "relationTo": "organization",
          "component": "relationship",
          "cell": "relationship"
        },
        {
          "name": "title",
          "kind": "text",
          "label": {
            "en": "Title",
            "ar": "العنوان"
          },
          "rules": {
            "required": true,
            "trim": true,
            "maxLength": 120,
            "index": true
          },
          "placeholder": {
            "en": "Introduction to Arabic calligraphy",
            "ar": "مقدمة في الخط العربي"
          },
          "prefix": {
            "en": "Course",
            "ar": "دورة"
          },
          "description": {
            "en": "The name a student sees in the catalogue.",
            "ar": "الاسم الذي يراه الطالب في الدليل."
          },
          "component": "text",
          "cell": "text"
        },
        {
          "name": "summary",
          "kind": "text",
          "label": {
            "en": "Summary",
            "ar": "الملخص"
          },
          "rules": {
            "maxLength": 200,
            "required": false
          },
          "component": "text",
          "cell": "text"
        },
        {
          "name": "fee",
          "kind": "number",
          "label": {
            "en": "Fee",
            "ar": "الرسوم"
          },
          "rules": {
            "required": false
          },
          "suffix": {
            "en": "per seat",
            "ar": "لكل مقعد"
          },
          "component": "number",
          "cell": "@asas/courses:./courses/ui/fee-cell.tsx#FeeCell"
        },
        {
          "name": "currency",
          "kind": "text",
          "label": {
            "en": "Currency",
            "ar": "العملة"
          },
          "rules": {
            "required": false
          },
          "options": [
            {
              "value": "SAR",
              "label": {
                "en": "Saudi riyal",
                "ar": "ريال سعودي"
              }
            },
            {
              "value": "USD",
              "label": {
                "en": "US dollar",
                "ar": "دولار أمريكي"
              }
            }
          ],
          "component": "radio",
          "cell": "text"
        },
        {
          "name": "level",
          "kind": "number",
          "label": {
            "en": "Level",
            "ar": "المستوى"
          },
          "rules": {
            "min": 1,
            "max": 5,
            "required": false
          },
          "component": "number",
          "cell": "number"
        },
        {
          "name": "notifications",
          "kind": "checkbox",
          "label": {
            "en": "Notifications",
            "ar": "الإشعارات"
          },
          "rules": {
            "required": false
          },
          "component": "checkbox",
          "cell": "checkbox"
        },
        {
          "name": "delivery",
          "kind": "text",
          "label": {
            "en": "Delivery",
            "ar": "طريقة التقديم"
          },
          "rules": {
            "required": false
          },
          "options": [
            {
              "value": "live",
              "label": {
                "en": "Live",
                "ar": "مباشر"
              }
            },
            {
              "value": "recorded",
              "label": {
                "en": "Recorded",
                "ar": "مسجل"
              }
            }
          ],
          "component": "radio",
          "cell": "text"
        },
        {
          "name": "audience",
          "kind": "text",
          "label": {
            "en": "Audience",
            "ar": "الجمهور"
          },
          "rules": {
            "required": false
          },
          "options": [
            {
              "value": "beginner",
              "label": {
                "en": "Beginner",
                "ar": "مبتدئ"
              }
            },
            {
              "value": "advanced",
              "label": {
                "en": "Advanced",
                "ar": "متقدم"
              }
            }
          ],
          "component": "text",
          "cell": "text"
        },
        {
          "name": "accessCode",
          "kind": "text",
          "label": {
            "en": "Access code",
            "ar": "رمز الدخول"
          },
          "rules": {
            "maxLength": 6,
            "required": false
          },
          "component": "text",
          "cell": "text"
        },
        {
          "name": "archived",
          "kind": "checkbox",
          "label": {
            "en": "Archived",
            "ar": "مؤرشف"
          },
          "rules": {
            "providedBy": {
              "create": "never",
              "update": "application"
            },
            "required": false
          },
          "component": "checkbox",
          "cell": "checkbox"
        },
        {
          "name": "topics",
          "kind": "textArray",
          "label": {
            "en": "Topics",
            "ar": "المواضيع"
          },
          "rules": {
            "maxRows": 2,
            "required": false
          },
          "options": [
            {
              "value": "script",
              "label": {
                "en": "Script",
                "ar": "الخط"
              }
            },
            {
              "value": "grammar",
              "label": {
                "en": "Grammar",
                "ar": "النحو"
              }
            },
            {
              "value": "recitation",
              "label": {
                "en": "Recitation",
                "ar": "التلاوة"
              }
            }
          ],
          "component": "textArray",
          "cell": "textArray"
        },
        {
          "name": "opensOn",
          "kind": "date",
          "label": {
            "en": "Opens on",
            "ar": "يفتح في"
          },
          "rules": {
            "required": false
          },
          "component": "date",
          "cell": "date"
        },
        {
          "name": "archiveReason",
          "kind": "text",
          "label": {
            "en": "Archive reason",
            "ar": "سبب الأرشفة"
          },
          "rules": {
            "maxLength": 200,
            "providedBy": {
              "create": "never",
              "update": "application"
            },
            "required": false
          },
          "component": "text",
          "cell": "text"
        },
        {
          "name": "tags",
          "kind": "relationship",
          "label": {
            "en": "Tags",
            "ar": "الوسوم"
          },
          "rules": {
            "required": false,
            "onDelete": "restrict"
          },
          "relationTo": "tags",
          "hasMany": true,
          "component": "relationship",
          "cell": "relationship"
        },
        {
          "name": "scheduledSessions",
          "kind": "join",
          "label": {
            "en": "Scheduled sessions",
            "ar": "الجلسات المجدولة"
          },
          "rules": {
            "required": false,
            "providedBy": {
              "create": "never",
              "update": "never"
            }
          },
          "relationTo": "sessions",
          "on": "course",
          "component": "join",
          "cell": "join"
        },
        {
          "name": "_status",
          "kind": "text",
          "label": {
            "en": "Status",
            "ar": "الحالة"
          },
          "rules": {
            "index": true,
            "required": false
          },
          "options": [
            {
              "value": "draft",
              "label": {
                "en": "Draft",
                "ar": "مسودة"
              }
            },
            {
              "value": "published",
              "label": {
                "en": "Published",
                "ar": "منشور"
              }
            }
          ],
          "component": "text",
          "cell": "text"
        },
        {
          "name": "details",
          "kind": "richText",
          "label": {
            "en": "Details",
            "ar": "التفاصيل"
          },
          "rules": {
            "required": false
          },
          "component": "richText",
          "cell": "richText",
          "sortable": false
        },
        {
          "name": "cover",
          "kind": "upload",
          "label": {
            "en": "Cover image",
            "ar": "صورة الغلاف"
          },
          "rules": {
            "required": false,
            "onDelete": "restrict"
          },
          "relationTo": "media",
          "component": "upload",
          "cell": "upload"
        }
      ],
      "operations": [
        {
          "name": "create",
          "effect": "create"
        },
        {
          "name": "update",
          "effect": "update"
        },
        {
          "name": "delete",
          "effect": "delete"
        },
        {
          "name": "find",
          "effect": "read"
        },
        {
          "name": "findByID",
          "effect": "read"
        },
        {
          "name": "count",
          "effect": "read"
        },
        {
          "name": "updateMany",
          "effect": "update",
          "updatesMany": true
        },
        {
          "name": "deleteMany",
          "effect": "delete"
        },
        {
          "name": "findVersions",
          "effect": "read"
        },
        {
          "name": "findVersionByID",
          "effect": "read"
        },
        {
          "name": "restoreVersion",
          "effect": "update"
        },
        {
          "name": "archive",
          "effect": "update",
          "fields": [
            {
              "name": "reason",
              "kind": "text",
              "label": {
                "en": "Reason",
                "ar": "السبب"
              },
              "rules": {
                "required": true,
                "maxLength": 200
              },
              "component": "text",
              "cell": "text"
            }
          ]
        },
        {
          "name": "unarchive",
          "effect": "update"
        },
        {
          "name": "unpublish",
          "effect": "update"
        },
        {
          "name": "findWithSessions",
          "effect": "read"
        }
      ],
      "useAsTitle": "title",
      "description": {
        "en": "The courses on offer.",
        "ar": "الدورات المعروضة."
      },
      "baseFilter": {
        "or": [
          {
            "archived": {
              "exists": false
            }
          },
          {
            "archived": {
              "equals": false
            }
          }
        ]
      },
      "drafts": {
        "autosave": {
          "interval": 2000
        }
      },
      "pages": {
        "list": {
          "path": "/courses",
          "page": {
            "shell": "@asas/mithaq:./src/ui/top-shell.tsx#PortalTopShell",
            "header": [
              {
                "title": {}
              }
            ],
            "nav": [
              {
                "nav": {}
              }
            ],
            "main": [
              {
                "layout": "./src/ui-portal/page.tsx#Page",
                "main": [
                  {
                    "list": {
                      "columns": [
                        {
                          "field": "title",
                          "cell": "text",
                          "decided": "table"
                        },
                        {
                          "field": "fee",
                          "cell": "@asas/courses:./courses/ui/fee-cell.tsx#FeeCell",
                          "decided": "field"
                        }
                      ],
                      "filters": [
                        "title"
                      ],
                      "search": [
                        "title"
                      ],
                      "empty": "@asas/courses:./courses/ui/no-courses-on-offer.tsx#NoCourses",
                      "row": [
                        {
                          "button": "archive",
                          "label": {
                            "en": "Archive",
                            "ar": "أرشفة"
                          },
                          "fields": [
                            "reason"
                          ],
                          "when": {
                            "or": [
                              {
                                "record.archived": {
                                  "exists": false
                                }
                              },
                              {
                                "record.archived": {
                                  "equals": false
                                }
                              }
                            ]
                          }
                        }
                      ],
                      "sort": "title",
                      "limit": 25
                    }
                  }
                ]
              }
            ]
          }
        },
        "edit": {
          "path": "/courses/:id",
          "page": {
            "shell": "@asas/mithaq:./src/ui/top-shell.tsx#PortalTopShell",
            "header": [
              {
                "title": {}
              }
            ],
            "nav": [
              {
                "nav": {}
              }
            ],
            "main": [
              {
                "layout": "@asas/mithaq:./src/ui/record-page.tsx#RecordPage",
                "main": [
                  {
                    "form": [
                      {
                        "section": "about",
                        "label": {
                          "en": "About the course",
                          "ar": "عن الدورة"
                        },
                        "fields": [
                          {
                            "field": "title",
                            "component": "text",
                            "decided": "table"
                          },
                          {
                            "field": "summary",
                            "component": "text",
                            "decided": "table"
                          },
                          {
                            "field": "cover",
                            "component": "upload",
                            "decided": "table"
                          },
                          {
                            "field": "details",
                            "component": "richText",
                            "decided": "table"
                          }
                        ]
                      },
                      {
                        "section": "pricing",
                        "label": {
                          "en": "Pricing",
                          "ar": "التسعير"
                        },
                        "fields": [
                          {
                            "row": [
                              {
                                "field": "fee",
                                "component": "number",
                                "decided": "table"
                              },
                              {
                                "field": "currency",
                                "component": "radio",
                                "decided": "field"
                              }
                            ]
                          },
                          {
                            "field": "audience",
                            "component": "buttonGroup",
                            "decided": "leaf"
                          }
                        ]
                      },
                      {
                        "section": "teaching",
                        "label": {
                          "en": "Teaching",
                          "ar": "التدريس"
                        },
                        "fields": [
                          {
                            "field": "delivery",
                            "component": "radio",
                            "decided": "field"
                          },
                          {
                            "field": "accessCode",
                            "component": "text",
                            "decided": "table",
                            "when": {
                              "delivery": {
                                "equals": "live"
                              }
                            }
                          },
                          {
                            "field": "opensOn",
                            "component": "date",
                            "decided": "table"
                          }
                        ]
                      }
                    ]
                  }
                ],
                "danger": [
                  {
                    "button": "archive",
                    "label": {
                      "en": "Archive",
                      "ar": "أرشفة"
                    },
                    "reload": true,
                    "component": "@asas/courses:./courses/ui/archive-button.tsx#ArchiveButton",
                    "confirm": {
                      "title": {
                        "en": "Archive this course?",
                        "ar": "أرشفة هذه الدورة؟"
                      },
                      "body": {
                        "en": "Students stop seeing it.",
                        "ar": "يتوقف الطلاب عن رؤيتها."
                      }
                    },
                    "when": {
                      "and": [
                        {
                          "or": [
                            {
                              "record.archived": {
                                "exists": false
                              }
                            },
                            {
                              "record.archived": {
                                "equals": false
                              }
                            }
                          ]
                        },
                        {
                          "$user.collections.courses.operations.archive": {
                            "equals": true
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
