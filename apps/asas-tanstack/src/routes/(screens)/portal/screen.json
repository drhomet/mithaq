    {
      "path": "/enrollments",
      "page": "list",
      "kayan": "enrollments",
      "permission": "enrollments.find"
    }
  ],
  "layouts": {
    "top": "@asas/mithaq:./src/ui/top-shell.tsx#PortalTopShell",
    "page": "./src/ui-portal/page.tsx#Page",
